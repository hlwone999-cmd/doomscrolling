    <!-- Placeholder name until /replica-brand. All copy written fresh. -->
    <string name="app_name">Tidemark</string>

    <string name="a11y_service_label">Tidemark video counter</string>
    <string name="a11y_service_description">Counts the short videos you scroll past in Instagram Reels, TikTok and YouTube Shorts, and shows a small counter while you watch. It reads the layout of those screens to notice when a new video appears. Nothing is sent anywhere: the app has no internet access.</string>

    <!-- S02 disclosure -->
    <string name="disclosure_title">First, what Tidemark reads</string>
    <string name="disclosure_intro">Tidemark counts short videos with Android\'s Accessibility Service. Here is exactly what that means, before anything is counted.</string>
    <string name="disclosure_reads_title">What the app reads</string>
    <string name="disclosure_read_1">Which app is on screen, but only to react to Instagram, TikTok and YouTube.</string>
    <string name="disclosure_read_2">The layout of the short-video screen, to notice when you move to the next video.</string>
    <string name="disclosure_read_3">The position of the video on screen (first, second, third...), so the same video is not counted twice. No text on the screen is read: no captions, names or messages.</string>
    <string name="disclosure_read_4">Scroll events in those apps.</string>
    <string name="disclosure_never_title">What it never does</string>
    <string name="disclosure_never_1">Save or send video content, captions, usernames or messages.</string>
    <string name="disclosure_never_2">Read anything in other apps.</string>
    <string name="disclosure_never_3">Use the internet. The app has no internet permission at all.</string>
    <string name="disclosure_where">Counts, times and sessions are stored only on this phone. You can pause, export or delete them at any time.</string>
    <string name="disclosure_agree">Agree and continue</string>
    <string name="disclosure_decline">Not now</string>

