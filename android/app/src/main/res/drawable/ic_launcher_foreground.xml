<?xml version="1.0" encoding="utf-8"?>
<!-- Tidemark adaptive icon: foreground layer (original drawing).
     A level gauge on the left, a wave below and the coral "tidemark" line
     showing how high it got. Everything sits inside the 66 dp safe circle
     (centre 54,54, radius 33), so no launcher mask clips it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- gauge spine and ticks -->
    <path
        android:pathData="M37,35V74M37,39h4M37,47h7M37,55h4M37,63h7"
        android:strokeColor="@color/brand_foam"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- the tidemark: the highest level reached -->
    <path
        android:pathData="M50,47H73"
        android:strokeColor="@color/brand_mark"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <!-- the wave -->
    <path
        android:fillColor="@color/brand_foam"
        android:pathData="M48,74V63.5C51.5,58 55.5,56.5 59.5,59.5C62.8,62 66,63.2 69.2,61.6C70.8,60.8 72,59.6 73,58.4V74Z" />
</vector>
