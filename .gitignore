# Gradle files
.gradle/
build/
.kotlin/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# ---- Tidemark additions (kept on top of the original rules above) ----

# Claude Code workspace: private skills, local settings, worktrees
.claude/

# Gradle wrapper cache / build output anywhere
**/.gradle/
**/build/
android/app/schemas/

# Signing and secrets: never commit
*.p12
*.pem
*.key
keystore.properties
signing.properties
.env
.env.*
secrets.*
*credentials*.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS and editor leftovers
.DS_Store
Thumbs.db
*.swp
*.tmp
~$*
